# ==============================================================================
# Android MCP Gateway - Environment Variables Template
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public Gateway URL (Set to your public domain e.g. https://your-app.onrender.com)
PUBLIC_URL=http://localhost:3000

# Security: Set to false in production to enforce strict token authentication
ALLOW_ANONYMOUS_DEV=true

# Security: Secret token for MCP Clients (Claude Code, Cursor, Cline)
MCP_API_KEY=mcp-user-secret-key-101
MCP_DEFAULT_USER_ID=user_101

# Security: Secret token for Android Phone WebSocket connection
MCP_DEFAULT_DEVICE_ID=android_device_01
MCP_DEVICE_TOKEN=device_secret_token_123

# Cloud Database & Clustering (Optional: Leave empty for local in-memory fallback)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# REDIS_URL=rediss://default:password@your-upstash-instance.upstash.io:6379

# Google OAuth 2.0 (Optional: For browser dashboard authentication)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
